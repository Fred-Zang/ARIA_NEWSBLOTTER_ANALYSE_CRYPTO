# Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Runtime : tout est privé sauf les placeholders/documentation
runtime/**
!runtime/**/
!runtime/**/.gitkeep
!runtime/**/README.md

# Captures : ajout manuel après anonymisation
/docs/images/*
!/docs/images/.gitkeep

# Données/artefacts susceptibles de contenir du contenu tiers ou interne
*.log
*.xlsx
*.xls
*.csv
*.json
*.txt
*.html
*.pbix
*.png
*.jpg
*.jpeg
*.webp

# Exceptions publiques explicites
!examples/reference_data/*.csv
!examples/reference_data/*.json
!README.md
!SECURITY.md

!requirements.txt
!requirements/*.txt
