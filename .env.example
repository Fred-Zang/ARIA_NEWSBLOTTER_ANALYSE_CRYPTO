# -----------------------------------------------------------------------------
# Exécution Docker locale : adapter si votre UID/GID hôte diffèrent
# -----------------------------------------------------------------------------
ARIA_DOCKER_UID=1000
ARIA_DOCKER_GID=1000

# -----------------------------------------------------------------------------
# API applicative — valeurs d'exemple uniquement
# -----------------------------------------------------------------------------
ARIA_API_BASE_URL=https://example.invalid
ARIA_WEB_BASE_URL=https://example.invalid
ARIA_API_KEY=
ARIA_WALLET_API_KEY=
ARIA_API_KEY_HEADER=X-Api-Key
ARIA_WALLET_API_KEY_HEADER=X-Api-Key
ARIA_PLATFORM_SOURCE_DOMAIN=platform.example
ARIA_HOTNEWS_EXCLUDED_SOURCE_TOKENS=
ARIA_SOURCE_DOMAIN_ALIASES=

# -----------------------------------------------------------------------------
# Services externes
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
ETHERSCAN_API_KEY=
ETHERSCAN_API_URL=https://api.etherscan.io/api
COINMARKETCAP_EXCHANGES_URL=https://coinmarketcap.com/rankings/exchanges/

# -----------------------------------------------------------------------------
# Contrôles réseau et rythme d'exécution
# -----------------------------------------------------------------------------
ARIA_ALLOW_PRIVATE_API_HOSTS=false
ARIA_HTTP_TIMEOUT_SECONDS=15
ARIA_MAX_HTTP_RESPONSE_BYTES=10485760
ARIA_MAX_REDIRECTS=5
ARIA_NEWS_CYCLE_SECONDS=300
ARIA_SUBPROCESS_TIMEOUT_SECONDS=1800
ARIA_MARKET_RUN_AFTER_UTC_HOUR=7
ARIA_DAILY_BRIEF_AFTER_UTC_HOUR=7
ARIA_DAILY_BRIEF_AFTER_UTC_MINUTE=10
ARIA_BLOCKCHAIN_RUN_AFTER_UTC_HOUR=3
ARIA_BLOCKCHAIN_POLL_SECONDS=60
ARIA_BLOCKCHAIN_RETRY_SECONDS=900

# -----------------------------------------------------------------------------
# Routes génériques de la démonstration publique
# Les routes réelles de production ne sont pas publiées.
# -----------------------------------------------------------------------------
ARIA_NEWS_API_PATH=/api/v1/news
ARIA_WORDLIST_API_PATH=/api/v1/news/wordlist
ARIA_LATEST_NEWS_API_PATH=/api/v1/news/latest
ARIA_ADD_NEWS_API_PATH=/api/v1/news/add
ARIA_UPDATE_NEWS_API_PATH=/api/v1/news/update
ARIA_UPDATE_FULL_TEXT_API_PATH=/api/v1/news/update/full-text
ARIA_UPDATE_LLM_STATUS_API_PATH=/api/v1/news/update/llm-summary
ARIA_COINLIST_API_PATH=/api/v1/coinlist
ARIA_WALLET_HOLDERS_API_PATH=/api/v1/wallet-holders
ARIA_WALLET_HOLDERS_PUSH_API_PATH=/api/v1/wallet-holders/push
ARIA_SOURCE_SCORE_PUSH_API_PATH=/api/v1/source-score/push
