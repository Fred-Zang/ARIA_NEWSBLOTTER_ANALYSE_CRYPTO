FROM python:3.12-slim-bookworm

ARG APP_UID=10001
ARG APP_GID=10001

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HOME=/tmp

RUN apt-get update \
    && apt-get install --no-install-recommends -y chromium chromium-driver ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid "${APP_GID}" app \
    && useradd --uid "${APP_UID}" --gid "${APP_GID}" --create-home --shell /usr/sbin/nologin app

WORKDIR /app
COPY requirements/ /tmp/requirements/
RUN python -m pip install --no-cache-dir -r /tmp/requirements/market.txt

COPY --chown=app:app src/ /app/src/
USER app

CMD ["python", "-m", "src.market_data.coinmarketcap_worker"]
